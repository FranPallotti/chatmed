# Copy to .env (never commit .env). Auth uses DefaultAzureCredential: no API keys.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=<pinned-deployment-name>
MODEL_SEED=7
LLM_TIMEOUT_SECONDS=60         # per model call
LLM_MAX_ATTEMPTS=4             # including the first; retried on 429/5xx/timeout/connection
LLM_BACKOFF_BASE_SECONDS=1     # exponential backoff with full jitter...
LLM_BACKOFF_MAX_SECONDS=20     # ...capped here
EXTRACTION_MAX_COMPLETION_TOKENS=4000
AGENT_MAX_ITERATIONS=8         # model calls per question before the safe fallback answer
AGENT_MAX_COMPLETION_TOKENS=1500
AGENT_FULLTEXT_MAX_CHARS=20000 # documents up to this size go to the model whole; larger: BM25
AGENT_BM25_TOP_K=3             # pages returned by the BM25 page search
AGENT_QUESTION_TIMEOUT_SECONDS=25 # whole question; then the safe fallback (target < 30 s)

PARSER=routing                 # routing | pdfium
OCR_BACKEND=local              # local (Tesseract) | docintel
DOCINTEL_ENDPOINT=             # only if OCR_BACKEND=docintel
OCR_DPI=300                    # page render resolution for OCR (part of parser_id)
OCR_LANG=eng                   # Tesseract language(s), e.g. eng or eng+spa (part of parser_id)
TESSERACT_CMD=                 # optional full path, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_MAX_CONCURRENCY=2          # pages OCRed at once across all sessions (~290 MB each); extra pages queue

SESSION_STORE=memory           # memory | encrypted_blob (stretch, not implemented yet)
SESSION_TTL_SECONDS=1800       # idle time before a session is wiped (D15)
SESSION_SWEEP_INTERVAL_SECONDS=60  # how often the TTL sweeper runs
MAX_SESSIONS=8                 # open sessions at once; above it POST /sessions is 503 capacity (4 GiB sizing)
MAX_DOCS_PER_SESSION=5
MAX_PAGES_PER_DOC=30
MAX_UPLOAD_MB=20
EXTRACTION_MAX_CHARS=60000     # page-window size for extraction calls
DUCKDB_MEMORY_LIMIT=128MB      # per-session in-memory DuckDB; no spill to disk (worst case: architecture.md)

# One database and one read-only role per tenant (D8); {tenant} is filled by code from the session.
# No password here: locally the shared PGPASSWORD from db/.env
# (`uv run --env-file .env --env-file db/.env ...`); in Azure one PGPASSWORD_<TENANT> per
# tenant, a Container Apps secret referencing Key Vault (D17). Missing both: startup fails.
TENANT_DB_DSN_TEMPLATE=postgresql://chatmed_reader_{tenant}@localhost:5432/tenant_{tenant}
TENANTS=acme,globex            # allow-list; a session's tenant must be one of these (D13a)
LOG_LEVEL=INFO
# Application Insights (metadata only, M5a AC5). Empty = telemetry off.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Local container only (docker compose, D16): service principal with only the
# "Cognitive Services OpenAI User" role on the Foundry resource, secret expiring in ~2 weeks.
# Read by DefaultAzureCredential (EnvironmentCredential), not by Settings: uncomment for
# the container. Leave them out when running on the host
# (az login) or in Azure (managed identity). Delete the SP afterwards: docs/deploy.md.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
