# Local database secrets. Copy to db/.env and change the values (db/.env is gitignored).
# Read by docker compose (container setup) and by libpq when the app connects:
#   uv run --env-file .env --env-file db/.env ...
POSTGRES_PASSWORD=change-me-admin
CHATMED_READER_PASSWORD=change-me-reader
# Same value as CHATMED_READER_PASSWORD: libpq reads PGPASSWORD for the tenant reader roles.
PGPASSWORD=change-me-reader
